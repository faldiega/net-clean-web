@model IEnumerable<NetApp.Application.DTOs.CategoryDto>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Categories</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Category</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>No</th>
            <th>Name</th>
            <th>Products</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @{var sequence = 1;}
        @foreach (var item in Model)
        {
            <tr>
                <td>@sequence</td>
                <td>@item.Name</td>
                <td>@item.ProductCount</td>
                <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.CategoryId"
                       class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.CategoryId"
                       class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
            sequence++;
        }
    </tbody>
</table>